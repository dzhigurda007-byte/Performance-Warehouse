{
  "name": "performance-warehouse",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-sharing": "~57.0.0",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-web": "^0.21.3",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p server",
    "test": "tsx --test tests/*.test.ts",
    "server:build": "esbuild server/src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=server/dist/pw-server.cjs --log-level=warning",
    "server:start": "npm run server:build && node server/dist/pw-server.cjs --web dist-web",
    "web:build": "expo export --platform web --output-dir dist-web"
  },
  "private": true
}
